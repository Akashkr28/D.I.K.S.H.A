# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.bak
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files hold the real API keys and must never be committed.
# the example file has no values in it, so it is safe to share.
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# D.I.K.S.H.A's private memory
/data

# retired 3D character models: large, unused, and not ours to redistribute
*.vrm

# editors and local tool settings
.vscode/
.idea/
*.swp
*~
.claude/settings.local.json

# public/intro (the recorded intro clips and their .txt notes) IS committed on purpose:
# production serves those files and never records new ones.
