# copy this file to .env.local and fill in your key. .env.local is git-ignored.
ANTHROPIC_API_KEY=

# optional: which Claude model she uses. haiku is fast and cheap for chatting.
# DIKSHA_MODEL=claude-haiku-4-5-20251001

# her voice. get a key at elevenlabs.io. without it she uses the browser's built-in voice.
ELEVENLABS_API_KEY=
# optional: a different voice. these work on the free plan:
#   Sarah   EXAVITQu4vr4xnSDxMaL  soft, warm (default)
#   Lily    pFZP5JQG7iQjIQuC4Bku  gentle, British
#   Jessica cgSgspJ2msm6clMCkdW9  bright, playful
#   Laura   FGY2WhTYpPnrIDTdsKH5  upbeat
#   Alice   Xb7hH8MSUJpSbSDYk0k2  clear, British
# voices from the ElevenLabs library need a paid plan.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# the contact form emails messages to you through resend.com (free plan is plenty).
# without a key, local dev saves messages to data/messages.json instead.
RESEND_API_KEY=
# optional: where messages go (defaults to the email in content/portfolio.ts) and who they
# come from. onboarding@resend.dev only delivers to your own Resend account's email until
# you verify a domain.
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# on Vercel: connect Upstash Redis (Storage tab) so the visitor rate limit is shared between
# server copies. it sets these for you; without them the limit is kept in memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
